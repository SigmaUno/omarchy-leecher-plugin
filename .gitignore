# QML/Qt editor and compilation artifacts
*.qmlc
*.jsc
*.swp
*~
.DS_Store

# Locally built Leecher backend
backend/app
backend/library-handler

# Local development helpers -- not shipped. install-backend.sh and
# uninstall-backend.sh are the supported scripts; these just wrap a
# deploy-to-live-config and a shell restart for iterating on the widget.
copybarwidget.sh
reset.sh

# The testing/ suite is tracked on the `testing` branch only and must not
# reach `main`; only its build/run artifacts are ignored.
testing/**/tmp/
testing/**/*.o
testing/**/build/
testing/unit/test_backend_logic
