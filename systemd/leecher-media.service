[Unit]
Description=Leecher Music for Omarchy backend
# SDL audio uses the PipeWire PulseAudio-compatible endpoint, so we must start
# after the audio graph is up. graphical-session-pre.target is too early: the
# app would open its SDL device before audio is available and silently play
# into nothing (position frozen at 0, no output stream) until restarted.
After=graphical-session.target pipewire.service pipewire-pulse.service wireplumber.service
Wants=pipewire.service pipewire-pulse.service wireplumber.service

[Service]
Type=simple
# WorkingDirectory/ExecStart paths are set by install-backend.sh from the real install
# location. They are never the source checkout.
WorkingDirectory=__LEECHER_DIR__
ExecStart=__LEECHER_DIR__/app --headless __LEECHER_DIR__/library.json
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
